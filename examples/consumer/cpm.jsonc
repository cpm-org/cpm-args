// A project that reads its command line with cpm-args, the way a user's would. CI runs `cpm test` here.
{
  "name": "consumer",
  "version": "0.1.0",
  "std": "c++20",
  "type": "static-lib",
  "dependencies": {
    // A user's project would have "cpm-args": "^0.1.0" from `cpm install cpm-args`.
    "cpm-args": "file:../.."
  },
  "devDependencies": {
    "cpm-test": "^0.1.0"
  }
}
